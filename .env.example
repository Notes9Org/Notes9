# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OAuth — Google client is used for "Sign in with Google" only; Gemini / @google/generative-ai is NOT used
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# API
# CHAT_API_URL also doubles as the catalyst literature-search base URL
# (catalyst is the same FastAPI app that hosts /chat, /biomni, and
# /literature/*). Set CATALYST_URL only if catalyst is ever split off
# from chat onto a different host.
NEXT_PUBLIC_NOTES9_API_URL=
CHAT_API_URL=
NEXT_PUBLIC_CHAT_API_URL=
BIOMNI_FUNCTION_URL=
NEXT_PUBLIC_AGENT_API_PERSIST_CONVERSATION=false

# AWS Transcribe (speech-to-text dictation)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# PostHog (product analytics: traffic, WAU/MAU, feature usage, geo location)
# NEXT_PUBLIC_POSTHOG_KEY is the PUBLIC project key (phc_...), safe to expose.
# HOST = ingestion endpoint. Direct: https://us.i.posthog.com (US) /
#   https://eu.i.posthog.com (EU). With a managed reverse proxy, set it to your
#   custom proxy domain instead, e.g. https://r.notes9.com — this dodges
#   ad-blockers. When proxied, also set UI_HOST to the real app host.
# UI_HOST = where the PostHog app lives (toolbar/links/replay). Only needed when
#   HOST is a proxy. US: https://us.posthog.com  EU: https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://r.notes9.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Collaborative Editing
# WebSocket URL of the Hocuspocus collaboration server. Enables real-time
# collaborative editing when set (e.g., wss://collab.notes9.com). Leave empty
# to use single-user editing mode with client-side auto-save.
NEXT_PUBLIC_COLLABORATION_URL=

# NCBI E-utilities API key (free: https://account.ncbi.nlm.nih.gov -> API Key Management).
# Optional — raises PubMed/PMC lookup rate limit from 3 to 10 req/s for paper attach.
NCBI_API_KEY=
